# 복사해서 backend/.env 로 쓴다 (.env 는 저장소에 넣지 않는다). 상대 경로는 backend/ 기준

# PostgreSQL 17. 비우면 PGlite(내장 PostgreSQL 17.5, 설치 없음)를 PGLITE_DIR 에 만든다
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# 포트 (루트 .env.example 의 NEXT_PUBLIC_API_BASE_URL 과 맞춘다)
# PORT=3001

# 씬 폴더: demo/demo.json · robot_home.json · routes.json · seed.json. 비우면 개발용 씬(scenes/dev)
# SCENE_DIR=scenes/dev

# 올린 파일(사진 · 허가서 · 도면)이 회차별로 쌓이는 곳
# FILES_DIR=.data/files

# 계산 서비스(경로 계획 + MuJoCo). off 이면 부르지 않고 사전 계산표(routes.json)만 쓴다
# COMPUTE_URL=http://127.0.0.1:8766
